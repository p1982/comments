{
  "name": "@comments/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve,dev -p api,web --parallel=2",
    "migration:generate": "node scripts/typeorm.cjs migration:generate apps/api/src/database/migrations/migration -d apps/api/src/database/data-source.ts",
    "migration:run": "node scripts/typeorm.cjs migration:run -d apps/api/src/database/data-source.ts",
    "migration:revert": "node scripts/typeorm.cjs migration:revert -d apps/api/src/database/data-source.ts",
    "dev:api": "nx serve api",
    "dev:web": "nx dev web",
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all --passWithNoTests",
    "typecheck": "nx run-many -t typecheck -p api,shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prepare": "husky",
    "check:branch": "node scripts/check-branch-name.cjs",
    "check": "npm run check:branch && npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "private": true,
  "engines": {
    "node": "22.22.1",
    "npm": ">=10.9.4"
  },
  "devDependencies": {
