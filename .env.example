# API
PORT=3001
API_VERSION=1
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# PostgreSQL (local npm / db:up)
DB_HOST=localhost
DB_PORT=5432
DB_USER=comments
DB_PASSWORD=comments
DB_NAME=comments
DB_SYNC=true
DB_LOGGING=false

NX_READY_SIGNAL_SOCKET=true

JWT_SECRET=secret
CAPTCHA_SECRET=secret

# true: fit image + comment.created go through in-memory queue
# false: process image and emit inside the create request
COMMENT_QUEUE_ENABLED=true
