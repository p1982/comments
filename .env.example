# API
PORT=3001
API_VERSION=1
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# PostgreSQL (local npm / db:up)
DB_HOST=localhost
DB_PORT=5432
DB_USER=comments
DB_PASSWORD=comments
DB_NAME=comments
DB_SYNC=true
DB_LOGGING=false

NX_READY_SIGNAL_SOCKET=true

JWT_SECRET=secret
CAPTCHA_SECRET=secret

# sync: fit image + emit in the create request
# memory: in-process queue
# rabbit: RabbitMQ broker
COMMENT_QUEUE_MODE=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672
COMMENT_QUEUE_NAME=comments.jobs
