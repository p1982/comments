# API
PORT=3001
API_VERSION=1
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# PostgreSQL (local npm / db:up)
# For Railway deployments, set DATABASE_URL (overrides the DB_* vars)
# Example: DATABASE_URL=postgres://user:pass@host:5432/comments
DB_HOST=localhost
DB_PORT=5432
DB_USER=comments
DB_PASSWORD=comments
DB_NAME=comments
DB_SYNC=true
DB_LOGGING=false

NX_READY_SIGNAL_SOCKET=true

JWT_SECRET=secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_MAX_AGE_MS=900000
JWT_REFRESH_MAX_AGE_MS=604800000

CAPTCHA_SECRET=secret
CAPTCHA_MAX_AGE_MS=300000

SALT_ROUNDS=10

NODE_ENV=development
GRAPHQL_PLAYGROUND=true

# sync: fit image + emit in the create request
# memory: in-process queue
# rabbit: RabbitMQ broker
COMMENT_QUEUE_MODE=memory # sync | memory | rabbit
RABBITMQ_URL=amqp://guest:guest@localhost:5672
COMMENT_QUEUE_NAME=comments.jobs

# Elasticsearch (local: docker compose up -d elasticsearch)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
