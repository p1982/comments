{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022"],
    "verbatimModuleSyntax": false,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["jest.config.cts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.d.ts"],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}
