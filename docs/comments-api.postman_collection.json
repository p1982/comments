{
  "info": {
    "_postman_id": "comments-api-collection",
    "name": "Comments API",
    "description": "Full collection for the Comments monorepo API (NestJS). Base URL: {{baseUrl}} (default http://localhost:3001/api/v1).\n\nAuth flow:\n1. GET /captcha  → sets `captcha` httpOnly cookie\n2. POST /auth/signup OR /auth/signin  → sets `access_token` + `refresh_token` httpOnly cookies\n3. Use POST /comments with multipart body (captcha value in body field, cookies sent automatically)\n\nVariables are in the `Comments API` environment (see Variables tab).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1",
      "type": "string",
      "description": "API base URL including version prefix"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token (httpOnly cookie, set automatically on signin/signup). Copy here only if you need to send it manually."
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "JWT refresh token (httpOnly cookie, set automatically on signin/signup)."
    },
    {
      "key": "captcha_cookie",
      "value": "",
      "type": "string",
      "description": "HMAC captcha token (httpOnly cookie, set automatically on GET /captcha)."
    },
    {
      "key": "captcha_answer",
      "value": "",
      "type": "string",
      "description": "Human-readable captcha text shown in the SVG (read the image, type answer here)."
    },
    {
      "key": "signupEmail",
      "value": "test@example.com",
      "type": "string",
      "description": "Email used for signup"
    },
    {
      "key": "signupPassword",
      "value": "Password1!",
      "type": "string",
      "description": "Password for signup/signin (min 6 chars)"
    },
    {
      "key": "signupFullName",
      "value": "TestUser",
      "type": "string",
      "description": "Full name (letters + digits only, 2–100 chars)"
    },
    {
      "key": "rootCommentId",
      "value": "",
      "type": "string",
      "description": "Root comment UUID — set after creating or listing comments"
    },
    {
      "key": "searchQuery",
      "value": "nestjs",
      "type": "string",
      "description": "Full-text search term for GET /comments/search"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns status of DB, GraphQL, and WebSocket. HTTP 200 = ok, 503 = degraded."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"status\":\"ok\",\"db\":\"ok\",\"graphql\":\"ok\",\"ws\":\"ok\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Captcha",
      "item": [
        {
          "name": "Get captcha (SVG + cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// The captcha cookie is set via Set-Cookie header (httpOnly).",
                  "// Postman automatically stores it in the cookie jar.",
                  "// Manually read the SVG text and set {{captcha_answer}} before creating a comment.",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is SVG', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/svg+xml');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/captcha",
              "host": ["{{baseUrl}}"],
              "path": ["captcha"]
            },
            "description": "Returns an SVG captcha image and sets an httpOnly `captcha` cookie (HMAC token, 5 min TTL).\n\nWorkflow:\n1. Run this request → Postman stores the `captcha` cookie automatically.\n2. Open the response body (SVG) and read the visible text.\n3. Set the `captcha_answer` variable to that text.\n4. Use `captcha_answer` in the `captcha` field when creating a comment."
          },
          "response": [
            {
              "name": "200 SVG + Set-Cookie",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "image/svg+xml" },
                {
                  "key": "Set-Cookie",
                  "value": "captcha=<hmac>; HttpOnly; Path=/; SameSite=Lax; Max-Age=300"
                }
              ],
              "body": "<svg>...</svg>"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body has status=success', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('success');",
                  "});",
                  "// access_token and refresh_token are httpOnly cookies — Postman stores them automatically."
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{signupFullName}}\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Creates a new user account. Sets httpOnly cookies:\n- `access_token` (JWT, 15 min)\n- `refresh_token` (JWT, 7 days)\n\nBody fields:\n- `fullName` — 2–100 chars, letters and digits only\n- `email` — valid email, max 255 chars\n- `password` — min 6 chars\n- `homepage` — optional URL"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                {
                  "key": "Set-Cookie",
                  "value": "access_token=<jwt>; HttpOnly; Path=/; SameSite=Lax | refresh_token=<jwt>; HttpOnly; Path=/; SameSite=Lax"
                }
              ],
              "body": "{\"status\":\"success\"}"
            },
            {
              "name": "409 Conflict (email taken)",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"statusCode\":409,\"message\":\"Email already taken\"}"
            }
          ]
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status=success', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('success');",
                  "});",
                  "// access_token and refresh_token cookies are set automatically."
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            },
            "description": "Validates email/password and sets httpOnly auth cookies:\n- `access_token` (JWT, 15 min)\n- `refresh_token` (JWT, 7 days)"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                {
                  "key": "Set-Cookie",
                  "value": "access_token=<jwt>; HttpOnly; Path=/; SameSite=Lax | refresh_token=<jwt>; HttpOnly; Path=/; SameSite=Lax"
                }
              ],
              "body": "{\"status\":\"success\"}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"statusCode\":401,\"message\":\"Invalid credentials\"}"
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status=success', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Uses the `refresh_token` httpOnly cookie to rotate both tokens.\n\nRequires: `refresh_token` cookie (set automatically by signin/signup).\nRotates: `access_token` + `refresh_token` cookies."
          },
          "response": [
            {
              "name": "200 OK — tokens rotated",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                {
                  "key": "Set-Cookie",
                  "value": "access_token=<new-jwt>; HttpOnly; Path=/; SameSite=Lax | refresh_token=<new-jwt>; HttpOnly; Path=/; SameSite=Lax"
                }
              ],
              "body": "{\"status\":\"success\"}"
            },
            {
              "name": "401 Unauthorized (no/bad refresh cookie)",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"statusCode\":401,\"message\":\"Unauthorized\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get root comments (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has items array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "  pm.expect(json.items).to.be.an('array');",
                  "});",
                  "// Auto-save first comment id for use in child-comments request",
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "  pm.collectionVariables.set('rootCommentId', json.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments?page=1&limit=25&sort=createdAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["comments"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number (≥1, default: 1)" },
                {
                  "key": "limit",
                  "value": "25",
                  "description": "Items per page (1–25, default: 25)"
                },
                {
                  "key": "sort",
                  "value": "createdAt",
                  "description": "Sort field: createdAt | fullName | email"
                },
                { "key": "order", "value": "desc", "description": "Sort direction: asc | desc" }
              ]
            },
            "description": "Returns a paginated list of root-level comments.\n\nQuery params:\n- `page` — page number (default: 1)\n- `limit` — 1–25 items per page (default: 25)\n- `sort` — `createdAt` | `fullName` | `email` (default: `createdAt`)\n- `order` — `asc` | `desc` (default: `desc`)\n\nResponse: `{ items: Comment[], total: number, page: number, limit: number }`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    {\n      \"id\": \"uuid\",\n      \"fullName\": \"TestUser\",\n      \"email\": \"test@example.com\",\n      \"homepage\": null,\n      \"text\": \"Hello <b>world</b>\",\n      \"parentId\": null,\n      \"userId\": \"uuid-or-null\",\n      \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n      \"attachment\": null\n    }\n  ],\n  \"total\": 1,\n  \"page\": 1,\n  \"limit\": 25\n}"
            }
          ]
        },
        {
          "name": "Get children by root comment ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{rootCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "{{rootCommentId}}"]
            },
            "description": "Returns all nested (child) comments for a given root comment.\n\nPath param:\n- `rootCommentId` — UUID of the root/parent comment (set from previous list response)\n\nResponse: same shape as the list endpoint."
          },
          "response": [
            {
              "name": "200 OK — children list",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"items\":[],\"total\":0,\"page\":1,\"limit\":25}"
            }
          ]
        },
        {
          "name": "Create comment (text only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has comment id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "});",
                  "// Save root comment id",
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('rootCommentId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fullName",
                  "value": "TestUser",
                  "type": "text",
                  "description": "2–100 chars, alphanumeric"
                },
                {
                  "key": "email",
                  "value": "test@example.com",
                  "type": "text",
                  "description": "valid email"
                },
                {
                  "key": "text",
                  "value": "Hello <b>world</b>",
                  "type": "text",
                  "description": "Plain text or allowed HTML tags: <a>, <code>, <i>, <strong>, <b>"
                },
                {
                  "key": "captcha",
                  "value": "{{captcha_answer}}",
                  "type": "text",
                  "description": "Value read from the captcha SVG (GET /captcha first)"
                },
                { "key": "homepage", "value": "", "type": "text", "description": "Optional URL" },
                {
                  "key": "parentId",
                  "value": "",
                  "type": "text",
                  "description": "Optional parent comment UUID for replies"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            },
            "description": "Creates a root comment or reply. Auth is optional (cookie `access_token` attaches the user).\n\n**Before calling:**\n1. GET /captcha → read SVG text → set `{{captcha_answer}}`\n2. Optionally: POST /auth/signin to attach a user\n\n**Body** (multipart/form-data):\n- `fullName` — required, 2–100 chars, alphanumeric\n- `email` — required, valid email\n- `text` — required, max 10 000 chars, allowed HTML: `<a href>`, `<code>`, `<i>`, `<strong>`, `<b>`\n- `captcha` — required, text from the SVG\n- `homepage` — optional URL\n- `parentId` — optional UUID for thread replies\n- `image` — optional file (JPG/PNG/GIF, fitted to 320×240 px)\n- `textFile` — optional `.txt` file (max 100 KB)\n\n**Cookies** (sent automatically by Postman cookie jar):\n- `captcha` — set by GET /captcha\n- `access_token` — set by signin/signup (optional)"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"uuid\",\n  \"fullName\": \"TestUser\",\n  \"email\": \"test@example.com\",\n  \"homepage\": null,\n  \"text\": \"Hello <b>world</b>\",\n  \"parentId\": null,\n  \"userId\": null,\n  \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n  \"attachment\": null\n}"
            }
          ]
        },
        {
          "name": "Create comment with image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "TestUser", "type": "text" },
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "text", "value": "Check out this image", "type": "text" },
                { "key": "captcha", "value": "{{captcha_answer}}", "type": "text" },
                {
                  "key": "image",
                  "value": "",
                  "type": "file",
                  "description": "JPG/PNG/GIF — will be fitted to 320×240 px by sharp"
                },
                { "key": "homepage", "value": "", "type": "text" },
                { "key": "parentId", "value": "", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            },
            "description": "Same as 'Create comment' but with an image file attachment.\nThe image is resized/fitted to max 320×240 px using sharp.\nSupported MIME types: image/jpeg, image/png, image/gif."
          },
          "response": []
        },
        {
          "name": "Create comment with text file",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "TestUser", "type": "text" },
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "text", "value": "See attached text file", "type": "text" },
                { "key": "captcha", "value": "{{captcha_answer}}", "type": "text" },
                {
                  "key": "textFile",
                  "value": "",
                  "type": "file",
                  "description": ".txt file, max 100 KB"
                },
                { "key": "homepage", "value": "", "type": "text" },
                { "key": "parentId", "value": "", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            },
            "description": "Same as 'Create comment' but with a plain-text file attachment (.txt, max 100 KB)."
          },
          "response": []
        },
        {
          "name": "Create reply to a comment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "ReplyUser", "type": "text" },
                { "key": "email", "value": "reply@example.com", "type": "text" },
                { "key": "text", "value": "This is a reply", "type": "text" },
                { "key": "captcha", "value": "{{captcha_answer}}", "type": "text" },
                {
                  "key": "parentId",
                  "value": "{{rootCommentId}}",
                  "type": "text",
                  "description": "UUID of the parent comment"
                },
                { "key": "homepage", "value": "", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["comments"]
            },
            "description": "Creates a reply to an existing comment. Set `parentId` to the root comment's UUID.\n`rootCommentId` is auto-saved from the 'Get root comments' or 'Create comment' test scripts."
          },
          "response": []
        },
        {
          "name": "Search comments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has items array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/search?q={{searchQuery}}&page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["comments", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "{{searchQuery}}",
                  "description": "Search query (1–100 chars), required"
                },
                { "key": "page", "value": "1", "description": "Page number (default: 1)" },
                {
                  "key": "limit",
                  "value": "25",
                  "description": "Items per page (1–25, default: 25)"
                }
              ]
            },
            "description": "Full-text search over comment text and author name via Elasticsearch.\n\nRequires Elasticsearch running (see `ELASTICSEARCH_NODE` env var).\nReturns hydrated comments from Postgres in ES hit order.\nHTML tags are stripped into `plainText` for matching.\n\nQuery params:\n- `q` — required, 1–100 chars\n- `page` — default: 1\n- `limit` — 1–25, default: 25"
          },
          "response": []
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "GQL — List comments",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query Comments($input: CommentsListInput) {\\n  comments(input: $input) {\\n    items {\\n      id\\n      fullName\\n      email\\n      homepage\\n      text\\n      parentId\\n      userId\\n      createdAt\\n      attachment { id url mimeType size }\\n    }\\n    total\\n    page\\n    limit\\n  }\\n}\",\n  \"variables\": {\n    \"input\": {\n      \"page\": 1,\n      \"limit\": 25,\n      \"sort\": \"createdAt\",\n      \"order\": \"desc\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "http://localhost:3001/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["graphql"]
            },
            "description": "GraphQL query: list root comments with pagination and sorting.\n\nPlayground available at http://localhost:3001/graphql (non-production only)."
          },
          "response": []
        },
        {
          "name": "GQL — Children by root ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query CommentChildren($rootId: String!) {\\n  commentChildren(rootId: $rootId) {\\n    items {\\n      id\\n      fullName\\n      email\\n      text\\n      parentId\\n      createdAt\\n    }\\n    total\\n  }\\n}\",\n  \"variables\": {\n    \"rootId\": \"{{rootCommentId}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
