        {
          "name": "Vote comment (like +1 / dislike -1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns vote result', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.commentId).to.eql(pm.collectionVariables.get('rootCommentId'));",
                  "  pm.expect(json.votesScore).to.be.a('number');",
                  "  pm.expect([-1, 0, 1]).to.include(json.userVote);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
